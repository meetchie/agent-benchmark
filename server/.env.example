# =============================================================================
# server/.env.example
# =============================================================================
# Copy to server/.env (or the repo-root .env; both are gitignored) and fill in.
# The arena and the benchmark server both need only ANTHROPIC_API_KEY, which is
# set once in the Benchmark Server section below.

# =============================================================================
# Arena (arena.py: BROWSERUSE vs RINDLER, both on a local headless Chromium)
# =============================================================================
# Both arms use BENCHMARK_AGENT_MODEL and the judge uses BENCHMARK_JUDGE_MODEL
# (below; both default to claude-sonnet-5-5). Flags override them: --model,
# --judge-model. Logs go to server/arena_runs/. No other keys are needed.

# Effort for the agent model (low, medium, high, xhigh, max, or "default").
# BENCHMARK_AGENT_EFFORT=medium

# Use a Chromium other than the one `uv run playwright install chromium` put in place.
# BENCHMARK_CHROMIUM_PATH=

# Only with LLM_PROVIDER=openai (the original gpt-4o setup; uv sync --extra openai).
# LLM_PROVIDER=anthropic
# OPENAI_API_KEY=

# Only for BENCHMARK_BROWSER_PROVIDER=browserbase on the benchmark server.
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=

# =============================================================================
# Benchmark Server (the live benchmark API)
# =============================================================================
# The only key it needs is ANTHROPIC_API_KEY. With none set, the server refuses to
# start (unless DEMO_MODE=true) and says so.

# Claude API key for the agent, the judge and the task generator.
ANTHROPIC_API_KEY=

# Models, one per role. All default to claude-sonnet-5-5.
# BENCHMARK_AGENT_MODEL=claude-sonnet-5-5
# BENCHMARK_JUDGE_MODEL=claude-sonnet-5-5
# BENCHMARK_TASKGEN_MODEL=claude-sonnet-5-5

# Hard limit for one agent run, in seconds (default 180).
# BENCHMARK_TIMEOUT_S=180

# Chromium runs headless by default; set to false to watch it.
# BENCHMARK_HEADLESS=true

# Who may use the server: "none" (default, one local user, no sign-in) or "clerk"
# (needs CLERK_ISSUER_URL or CLERK_PUBLISHABLE_KEY).
AUTH_MODE=none
# CLERK_PUBLISHABLE_KEY=
# CLERK_ISSUER_URL=

# Runs per user per rolling 24 hours; 0 = unlimited. Default: 0 with AUTH_MODE=none, 3 with clerk.
# DAILY_RUN_QUOTA=0
# Runs one user may have going at once (default 2); 0 = unlimited.
# MAX_CONCURRENT_RUNS=2

# Where finished runs are saved, one JSON file each (default server/runs/).
# RUNS_DIR=

# Canned runs and tasks: the whole UI works with no key and no browser.
DEMO_MODE=false

# Browser: "local" (default, Chromium on this machine) or "browserbase" (needs the two Browserbase keys above).
BENCHMARK_BROWSER_PROVIDER=local

# Optional
# ALLOWED_ORIGINS=http://localhost:5180,http://localhost:5173
# INTERNAL_API_KEY=a-shared-secret   # if set, requests must send it in X-Internal-Key
