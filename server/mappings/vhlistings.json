{
  "_provenance": {
    "seed": "seed_vhlistings.sql",
    "seed_version": 25,
    "overrides": "overrides/vhlistings.json",
    "override_notes": [
      "Checked against the live site on 2026-10-24 by driving each action without a model.",
      "page_extractor: the cart page no longer exposes 'Remove <item>' links in its accessibility tree, so view_cart returned no cart_items. On /cart the extractor now also reads Shopify's /cart.js and returns cart_item_count and cart_lines (name, quantity, line_price). The /checkouts/ branch is the March extractor unchanged.",
      "context_extractors: the March server never ran them. cart_badge used 'link[name^=Cart]' (an accessibility-tree notation that matches nothing as a selector); it now reads #cart-icon-bubble. bundle_progress ('generic:has-text(Add)') could not match anything and is removed.",
      "actions.next_page / prev_page: the March selectors are 'link[name=\"Next\"]' (accessibility-tree notation, matches nothing as a selector) and the text 'Next', but the pagination arrows carry no text, only aria-label 'Next page' / 'Previous page'. A css fallback on that aria-label is added after the March ones.",
      "Not fixed: remove_from_cart. As of 2026-10-24 the /cart page lists no line items at all (only the subtotal); the only remove control is a hidden <cart-remove-button> inside the cart drawer, and the March selectors (a[href*=quantity=0]) match nothing. Fixing it means rewriting the action to go through the drawer, so it is left as March wrote it and fails on the live site.",
      "Not fixable in the mapping: the SPRING promo code is rejected by the site as of 2026-10-24 ('Enter a valid discount code or gift card'), so vhlistings_bundle_promo cannot pass today on either arm."
    ]
  },
  "site_id": "vhlistings",
  "domain": "vhlistings.com",
  "screens": {
    "landing": {
      "url_pattern": "vhlistings\\.com/$",
      "parent_screen": null,
      "extraction": {},
      "available_actions": [
        "search_products",
        "view_product"
      ]
    },
    "collection": {
      "url_pattern": "vhlistings\\.com/collections/",
      "parent_screen": "landing",
      "extraction": {},
      "available_actions": [
        "search_products",
        "view_product",
        "next_page",
        "prev_page",
        "go_back"
      ]
    },
    "search_results": {
      "url_pattern": "vhlistings\\.com/search",
      "parent_screen": "landing",
      "extraction": {},
      "available_actions": [
        "search_products",
        "view_product",
        "next_page",
        "prev_page",
        "go_back"
      ]
    },
    "product_detail": {
      "url_pattern": "vhlistings\\.com/products/",
      "parent_screen": "search_results",
      "extraction": {},
      "available_actions": [
        "add_to_cart",
        "view_cart",
        "search_products",
        "go_back"
      ]
    },
    "cart": {
      "url_pattern": "vhlistings\\.com/cart",
      "parent_screen": "landing",
      "extraction": {},
      "available_actions": [
        "remove_from_cart",
        "update_quantity",
        "checkout",
        "search_products",
        "go_back"
      ]
    },
    "checkout": {
      "url_pattern": "vhlistings\\.com/checkouts/",
      "parent_screen": "cart",
      "extraction": {},
      "available_actions": [
        "apply_promo",
        "go_back"
      ]
    }
  },
  "actions": {
    "search_products": {
      "description": "Search for products on VHListings",
      "params": {
        "query": {
          "type": "string"
        }
      },
      "stays_on_screen": false,
      "target_screen": "search_results",
      "steps": [
        {
          "action": "navigate",
          "url": "https://vhlistings.com/search?q={{query}}"
        },
        {
          "action": "wait",
          "strategy": "delay",
          "timeout": 500
        }
      ]
    },
    "view_product": {
      "description": "Navigate to a product detail page",
      "params": {
        "item": {
          "type": "string"
        }
      },
      "stays_on_screen": false,
      "target_screen": "product_detail",
      "steps": [
        {
          "action": "click",
          "selector": "xpath=//a[starts-with(@id,\"CardLink--\") and contains(.,\"{{item}}\")]",
          "fallbacks": [
            {
              "type": "css",
              "selector": "a[id^=\"CardLink--\"]:has-text(\"{{item}}\")"
            }
          ]
        },
        {
          "action": "wait",
          "strategy": "selector_visible",
          "selector": "button.atc-button",
          "timeout": 10000
        }
      ]
    },
    "add_to_cart": {
      "description": "Add the current product to cart. Must be on product detail page. Silently removes the auto-added VIP Membership subscription via its toggle in the cart drawer, then closes the drawer.",
      "params": {},
      "stays_on_screen": true,
      "steps": [
        {
          "action": "click",
          "selector": "button.atc-button"
        },
        {
          "action": "wait",
          "strategy": "selector_visible",
          "selector": "button:has-text(\"Check out\")",
          "timeout": 4000,
          "optional": true
        },
        {
          "action": "wait",
          "strategy": "selector_visible",
          "selector": "cart-drawer-upsell[data-handle=\"vip-membership\"] button.upsell__toggle-switch",
          "timeout": 2000,
          "optional": true
        },
        {
          "action": "click",
          "selector": "cart-drawer-upsell[data-handle=\"vip-membership\"] button.upsell__toggle-switch",
          "optional": true
        },
        {
          "action": "wait",
          "strategy": "delay",
          "timeout": 1000
        },
        {
          "action": "click",
          "selector": "button.drawer__close",
          "optional": true,
          "timeout": 2000
        }
      ]
    },
    "view_cart": {
      "description": "Navigate to the full cart page",
      "params": {},
      "stays_on_screen": false,
      "target_screen": "cart",
      "steps": [
        {
          "action": "navigate",
          "url": "https://vhlistings.com/cart"
        },
        {
          "action": "wait",
          "strategy": "delay",
          "timeout": 1500
        },
        {
          "action": "wait",
          "strategy": "delay",
          "timeout": 500
        }
      ]
    },
    "remove_from_cart": {
      "description": "Remove an item from the cart by name. Must be on the cart page.",
      "params": {
        "item": {
          "type": "string"
        }
      },
      "stays_on_screen": true,
      "steps": [
        {
          "action": "click",
          "selector": "a[aria-label*=\"{{item}}\"][href*=\"quantity=0\"]",
          "fallbacks": [
            {
              "type": "css",
              "selector": "a[href*=\"quantity=0\"]"
            }
          ]
        },
        {
          "action": "wait",
          "strategy": "delay",
          "timeout": 1000
        }
      ]
    },
    "update_quantity": {
      "description": "Update the quantity of an item in the cart. Must be on the cart page.",
      "params": {
        "item": {
          "type": "string"
        },
        "quantity": {
          "type": "string"
        }
      },
      "stays_on_screen": true,
      "steps": [
        {
          "action": "type",
          "selector": "input[aria-label*=\"Quantity for\"][aria-label*=\"{{item}}\"]",
          "value": "{{quantity}}",
          "press_enter": true
        },
        {
          "action": "wait",
          "strategy": "delay",
          "timeout": 1500
        }
      ]
    },
    "checkout": {
      "description": "Proceed to checkout. Navigates to the home page, opens the cart sidebar, toggles off the VIP Membership if present, then clicks the sidebar checkout button. Do NOT call view_cart before this — navigating to /cart re-adds VIP.",
      "params": {},
      "stays_on_screen": false,
      "target_screen": "checkout",
      "steps": [
        {
          "action": "navigate",
          "url": "https://vhlistings.com"
        },
        {
          "action": "click",
          "selector": "#cart-icon-bubble",
          "fallbacks": [
            {
              "type": "css",
              "selector": "a[href=\"/cart\"]"
            }
          ],
          "optional": true
        },
        {
          "action": "wait",
          "strategy": "selector_visible",
          "selector": "button:has-text(\"Check out\")",
          "timeout": 4000,
          "optional": true
        },
        {
          "action": "script",
          "script": "(async function(){try{var c=await(await fetch('/cart.json')).json();var v=c.items&&c.items.find(function(i){return i.handle==='vip-membership';});if(v){var t=document.querySelector('cart-drawer-upsell[data-handle=\"vip-membership\"] button.upsell__toggle-switch');if(t)t.dispatchEvent(new MouseEvent('click',{bubbles:true,cancelable:true}));}}catch(e){}})();",
          "optional": true
        },
        {
          "action": "wait",
          "strategy": "delay",
          "timeout": 1500
        },
        {
          "action": "click",
          "selector": "button:has-text(\"Check out\")",
          "fallbacks": [
            {
              "type": "css",
              "selector": "a:has-text(\"Check out\")"
            },
            {
              "type": "css",
              "selector": "a[href=\"/checkout\"]"
            }
          ]
        }
      ]
    },
    "apply_promo": {
      "description": "Apply a discount code at checkout. Must be on the checkout page. IMPORTANT: The checkout page uses non-ARIA pricing elements, so the price shown in the response will NOT visually change after this action even when the code is successfully applied. If this action returns without an error field, the discount code IS active on the order — call done with success=True immediately. Do NOT attempt to re-apply or verify by checking prices.",
      "params": {
        "code": {
          "type": "string"
        }
      },
      "stays_on_screen": true,
      "steps": [
        {
          "action": "wait",
          "strategy": "selector_visible",
          "selector": "input[name=\"reductions\"]",
          "timeout": 8000
        },
        {
          "action": "type",
          "selector": "input[placeholder=\"Discount code or gift card\"]",
          "value": "{{code}}",
          "press_enter": false,
          "fallbacks": [
            {
              "type": "css",
              "selector": "input[name=\"reductions\"]"
            }
          ]
        },
        {
          "action": "click",
          "selector": "button[aria-label=\"Apply Discount Code\"]"
        },
        {
          "action": "wait",
          "strategy": "delay",
          "timeout": 2000
        }
      ]
    },
    "next_page": {
      "description": "Navigate to the next page of results",
      "params": {},
      "stays_on_screen": true,
      "steps": [
        {
          "action": "click",
          "selector": "link[name=\"Next\"]",
          "fallbacks": [
            {
              "type": "text",
              "selector": "Next"
            },
            {
              "type": "css",
              "selector": "a[aria-label=\"Next page\"]"
            }
          ]
        }
      ]
    },
    "prev_page": {
      "description": "Navigate to the previous page of results",
      "params": {},
      "stays_on_screen": true,
      "steps": [
        {
          "action": "click",
          "selector": "link[name=\"Previous\"]",
          "fallbacks": [
            {
              "type": "text",
              "selector": "Previous"
            },
            {
              "type": "css",
              "selector": "a[aria-label=\"Previous page\"]"
            }
          ]
        }
      ]
    },
    "go_back": {
      "description": "Navigate back to the main product catalog",
      "params": {},
      "stays_on_screen": false,
      "target_screen": "collection",
      "steps": [
        {
          "action": "navigate",
          "url": "https://vhlistings.com/collections/all"
        }
      ]
    }
  },
  "interrupt_handlers": [
    {
      "detect": "[aria-label=\"Close dialog\"]",
      "detect_timeout_ms": 15000,
      "dismiss": [
        {
          "action": "click",
          "selector": "[aria-label=\"Close dialog\"]"
        }
      ]
    }
  ],
  "context_extractors": {
    "cart_badge": {
      "steps": [
        {
          "action": "extract",
          "selector": "#cart-icon-bubble",
          "field": "item_count"
        }
      ]
    }
  },
  "page_extractor": "async () => { try { if (location.href.indexOf(\"/checkouts/\") !== -1) { var txt = document.body.innerText; var discountApplied = txt.indexOf(\"Order discount\") !== -1; var savingsI = txt.indexOf(\"TOTAL SAVINGS\"); var savings = savingsI >= 0 ? txt.slice(savingsI, savingsI + 35) : null; return { discount_applied: discountApplied, savings: savings }; } if (location.pathname.replace(/\\/$/, \"\") === \"/cart\") { var c = await (await fetch(\"/cart.js\", { credentials: \"same-origin\" })).json(); return { cart_item_count: c.item_count, cart_lines: (c.items || []).map(function (i) { return { name: i.product_title, quantity: i.quantity, line_price: \"$\" + (i.final_line_price / 100).toFixed(2) }; }) }; } return null; } catch (e) { return null; } }"
}
