{
  "_provenance": {
    "seed": "seed_shipt.sql",
    "seed_version": 1,
    "overrides": "overrides/shipt.json",
    "override_notes": [
      "defaults.store_slug: search_products navigates to /shop/{{store_slug}}/search. The March server filled store_slug from the selected store and fell back to 'target' in its own code; the local interpreter takes the fallback from the mapping instead.",
      "actions.select_store.sets_context: remembers the chosen store so later searches use its slug (the March server did this in code for select_store)."
    ]
  },
  "site_id": "shipt",
  "domain": "shipt.com",
  "screens": {
    "landing": {
      "url_pattern": "shipt\\.com/$",
      "parent_screen": null,
      "extraction": {},
      "available_actions": [
        "update_address"
      ]
    },
    "shop": {
      "url_pattern": "shipt\\.com/shop$",
      "parent_screen": "landing",
      "extraction": {},
      "available_actions": [
        "search_products",
        "view_cart",
        "update_address",
        "select_store"
      ]
    },
    "search_results": {
      "url_pattern": "shipt\\.com/shop/.+/search",
      "parent_screen": "shop",
      "extraction": {},
      "available_actions": [
        "search_products",
        "add_to_cart",
        "view_product",
        "view_cart",
        "next_page",
        "prev_page",
        "go_back"
      ]
    },
    "product_detail": {
      "url_pattern": "shipt\\.com/shop/products/",
      "parent_screen": "search_results",
      "extraction": {},
      "available_actions": [
        "add_to_cart",
        "view_cart",
        "search_products",
        "go_back"
      ]
    },
    "cart": {
      "url_pattern": "shipt\\.com/shop/cart",
      "parent_screen": "shop",
      "extraction": {},
      "available_actions": [
        "remove_from_cart",
        "update_quantity",
        "checkout",
        "search_products",
        "go_back"
      ]
    },
    "checkout": {
      "url_pattern": "shipt\\.com/checkout",
      "parent_screen": "cart",
      "extraction": {},
      "available_actions": [
        "go_back"
      ]
    },
    "order_confirmation": {
      "url_pattern": "shipt\\.com/order-confirmation",
      "parent_screen": null,
      "extraction": {},
      "available_actions": []
    }
  },
  "actions": {
    "update_address": {
      "params": {
        "address": {
          "type": "string",
          "required": true
        }
      },
      "steps": [
        {
          "action": "navigate",
          "url": "https://www.shipt.com/delivery"
        },
        {
          "action": "wait",
          "strategy": "selector_visible",
          "selector": "#address-autocomplete-homepage-textbox",
          "timeout": 10000
        },
        {
          "action": "click",
          "selector": "#address-autocomplete-homepage-textbox"
        },
        {
          "action": "type",
          "selector": "#address-autocomplete-homepage-textbox",
          "value": "{{address}}"
        },
        {
          "action": "wait",
          "strategy": "selector_visible",
          "selector": "li[role='option']",
          "timeout": 5000
        },
        {
          "action": "click",
          "selector": "li[role='option']:first-child"
        },
        {
          "action": "click",
          "selector": "button[aria-label='Find stores near you - address input']"
        },
        {
          "action": "wait",
          "strategy": "selector_visible",
          "selector": "input[placeholder='What are you looking for?']",
          "timeout": 15000
        }
      ],
      "target_screen": "shop"
    },
    "search_products": {
      "params": {
        "query": {
          "type": "string",
          "required": true
        }
      },
      "steps": [
        {
          "action": "navigate",
          "url": "https://www.shipt.com/shop/{{store_slug}}/search?query={{query}}"
        },
        {
          "action": "wait",
          "strategy": "selector_visible",
          "selector": "button[aria-label*='Add 1']",
          "timeout": 15000
        }
      ],
      "target_screen": "search_results"
    },
    "add_to_cart": {
      "params": {
        "item": {
          "type": "string",
          "required": true
        }
      },
      "steps": [
        {
          "action": "click",
          "selector": "button[aria-label*='Add 1'][aria-label*='{{item}}'][aria-label*='to cart']",
          "fallbacks": [
            {
              "type": "css",
              "selector": "button[aria-label*='Increase'][aria-label*='{{item}}']"
            },
            {
              "type": "css",
              "selector": "button[aria-label*='Add'][aria-label*='{{item}}'][aria-label*='more']"
            }
          ]
        },
        {
          "action": "wait",
          "strategy": "delay",
          "timeout": 1500,
          "optional": true
        },
        {
          "action": "click",
          "selector": "[role='dialog'] button:has-text('Add to cart')",
          "optional": true,
          "timeout": 2000,
          "fallbacks": [
            {
              "type": "css",
              "selector": "div[class*='modal'] button:has-text('Add to cart')"
            },
            {
              "type": "text",
              "selector": "Add to cart"
            }
          ]
        },
        {
          "action": "wait",
          "strategy": "delay",
          "timeout": 500,
          "optional": true
        },
        {
          "action": "click",
          "selector": "[role='dialog'] button[aria-label*='Close']",
          "optional": true,
          "timeout": 2000,
          "fallbacks": [
            {
              "type": "css",
              "selector": "[role='dialog'] button[aria-label*='close']"
            },
            {
              "type": "css",
              "selector": "div[class*='modal'] button[aria-label*='Close']"
            },
            {
              "type": "css",
              "selector": "button[aria-label='Close']"
            }
          ]
        }
      ],
      "stays_on_screen": true
    },
    "view_cart": {
      "steps": [
        {
          "action": "navigate",
          "url": "https://www.shipt.com/shop/cart"
        },
        {
          "action": "wait",
          "strategy": "delay",
          "timeout": 3000
        }
      ],
      "target_screen": "cart"
    },
    "view_product": {
      "params": {
        "item": {
          "type": "string",
          "required": true
        }
      },
      "steps": [
        {
          "action": "click",
          "selector": "a[aria-label*='{{item}}'][href*='/shop/products/']"
        }
      ],
      "target_screen": "product_detail"
    },
    "remove_from_cart": {
      "params": {
        "item": {
          "type": "string",
          "required": true
        }
      },
      "steps": [
        {
          "action": "click",
          "selector": "button[aria-label*='Remove'][aria-label*='{{item}}'][aria-label*='from Cart']"
        }
      ],
      "stays_on_screen": true
    },
    "update_quantity": {
      "params": {
        "item": {
          "type": "string",
          "required": true
        },
        "quantity": {
          "type": "string",
          "required": true
        }
      },
      "steps": [
        {
          "action": "select",
          "selector": "select[aria-label*='{{item}}'][aria-label*='quantity']",
          "value": "{{quantity}}"
        }
      ],
      "stays_on_screen": true
    },
    "checkout": {
      "steps": [
        {
          "action": "click",
          "selector": "a[href*='signup?guest']"
        }
      ],
      "target_screen": "checkout"
    },
    "select_store": {
      "params": {
        "store": {
          "type": "string",
          "required": true
        }
      },
      "steps": [
        {
          "action": "click",
          "selector": "a[href*='/shop/'][aria-label*='{{store}}']"
        }
      ],
      "target_screen": "shop",
      "sets_context": {
        "store": "{{store}}",
        "store_slug": "{{store:slug}}"
      }
    },
    "next_page": {
      "steps": [
        {
          "action": "click",
          "selector": "button[aria-label='Next']",
          "fallbacks": [
            {
              "type": "css",
              "selector": "button[aria-label*='next page']"
            },
            {
              "type": "css",
              "selector": "a[aria-label*='Next']"
            },
            {
              "type": "text",
              "selector": "Next"
            }
          ]
        }
      ],
      "stays_on_screen": true
    },
    "prev_page": {
      "steps": [
        {
          "action": "click",
          "selector": "button[aria-label='Previous']",
          "fallbacks": [
            {
              "type": "css",
              "selector": "button[aria-label*='previous page']"
            },
            {
              "type": "css",
              "selector": "a[aria-label*='Previous']"
            },
            {
              "type": "text",
              "selector": "Previous"
            }
          ]
        }
      ],
      "stays_on_screen": true
    },
    "go_back": {
      "steps": [
        {
          "action": "navigate",
          "url": "https://www.shipt.com/shop"
        }
      ],
      "target_screen": "shop"
    }
  },
  "context_extractors": {
    "cart": {
      "steps": [
        {
          "action": "extract",
          "selector": ":is(button, a):has-text('carts'), :is(button, a):has-text('items in cart')",
          "field": "summary"
        }
      ]
    },
    "address": {
      "steps": [
        {
          "action": "extract",
          "selector": "button:has-text('Main St'), button:has-text('Address')",
          "field": "address"
        }
      ]
    }
  },
  "defaults": {
    "store_slug": "target"
  }
}
