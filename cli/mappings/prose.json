{
  "site_id": "prose",
  "domain": "www.prose.com",
  "screens": {
    "homepage": {
      "url_pattern": "prose\\.com/?$",
      "available_actions": ["view_accessories", "view_product", "view_cart", "view_gift_cards", "search_products", "go_back"]
    },
    "accessories": {
      "url_pattern": "prose\\.com/products/accessories",
      "available_actions": ["view_product", "view_cart", "view_gift_cards", "view_accessories", "search_products", "go_back"]
    },
    "product_detail": {
      "url_pattern": "prose\\.com/products/prose-",
      "available_actions": ["add_to_cart", "view_product", "view_accessories", "view_cart", "view_gift_cards", "search_products", "go_back"]
    },
    "brushes": {
      "url_pattern": "prose\\.com/products/brushes",
      "available_actions": ["add_to_cart", "view_product", "view_accessories", "view_cart", "view_gift_cards", "search_products", "go_back"]
    },
    "cart": {
      "url_pattern": "prose\\.com/checkout/accessories",
      "available_actions": ["view_cart", "view_product", "remove_from_cart", "view_accessories", "view_gift_cards", "search_products", "go_back"]
    },
    "gift": {
      "url_pattern": "prose\\.com/gift",
      "available_actions": ["view_accessories", "view_product", "view_cart", "view_gift_cards", "search_products", "go_back"]
    }
  },
  "actions": {
    "view_accessories": {
      "description": "Open the accessories catalog: brushes, hair towel wrap, candle, eye patches and digital gift cards. page_info.product_cards lists every product with its own price.",
      "steps": [
        {"action": "navigate", "url": "https://www.prose.com/products/accessories"},
        {"action": "wait", "strategy": "selector_visible", "selector": "a[href*='/products/'] h2", "timeout": 8000}
      ],
      "target_screen": "accessories"
    },
    "view_product": {
      "description": "Open a product's page from the accessories catalog. Pass its name as the catalog shows it, for example 'Candle' or 'Tipped-Metal Brush'. page_info describes the product and its price.",
      "params": {
        "item": {"type": "string", "required": true, "description": "Product name as shown on the accessories page"}
      },
      "steps": [
        {"action": "navigate", "url": "https://www.prose.com/products/accessories"},
        {"action": "wait", "strategy": "selector_visible", "selector": "a[href*='/products/'] h2", "timeout": 8000},
        {"action": "press_key", "value": "Escape", "optional": true},
        {"action": "click", "selector": "a:has-text('{{item}}')", "timeout": 2000, "fallbacks": [
          {"type": "text", "selector": "{{item}}"},
          {"type": "css", "selector": "h2:has-text('{{item}}')"}
        ]},
        {"action": "wait", "strategy": "selector_visible", "selector": "h1", "timeout": 2000}
      ],
      "target_screen": "product_detail"
    },
    "add_to_cart": {
      "description": "Add one unit of the product whose page is open to the cart. Open the product first with view_product; item is the name of that product.",
      "params": {
        "item": {"type": "string", "required": true, "description": "Name of the product whose page is open"}
      },
      "steps": [
        {"action": "press_key", "value": "Escape", "optional": true},
        {"action": "click", "selector": "[data-testid='add-to-cart'] >> nth=0", "timeout": 2000, "fallbacks": [
          {"type": "css", "selector": "button:has-text('Add to cart') >> nth=0"},
          {"type": "text_exact", "selector": "Add to cart"}
        ]}
      ],
      "stays_on_screen": true
    },
    "view_cart": {
      "description": "Open the cart page. page_info shows the cart title, each line as cart_items (name, price, quantity) and the order_summary (subtotal, shipping, total).",
      "steps": [
        {"action": "navigate", "url": "https://www.prose.com/checkout/accessories"},
        {"action": "wait", "strategy": "selector_visible", "selector": "main", "timeout": 2000},
        {"action": "wait", "strategy": "selector_visible", "selector": "h1:has-text('Your cart')", "timeout": 8000, "optional": true}
      ],
      "target_screen": "cart"
    },
    "view_gift_cards": {
      "description": "Open the digital gift card page: the amounts on offer and how gifting works (page_info.main_text).",
      "steps": [
        {"action": "navigate", "url": "https://www.prose.com/gift"},
        {"action": "wait", "strategy": "selector_visible", "selector": "main", "timeout": 2000},
        {"action": "wait", "strategy": "selector_visible", "selector": "text=Choose your gift amount", "timeout": 8000, "optional": true}
      ],
      "target_screen": "gift"
    },
    "go_back": {
      "description": "Return to the accessories catalog.",
      "steps": [
        {"action": "navigate", "url": "https://www.prose.com/products/accessories"},
        {"action": "wait", "strategy": "selector_visible", "selector": "a[href*='/products/'] h2", "timeout": 8000}
      ],
      "target_screen": "accessories"
    },
    "remove_from_cart": {
      "description": "Remove one item from the cart. Open the cart first with view_cart; item is the name of the line to remove.",
      "params": {
        "item": {"type": "string", "required": true, "description": "Name of the cart line to remove, as shown in cart_items"}
      },
      "steps": [
        {"action": "click", "selector": "*:has(button:has-text('Remove')):has-text('{{item}}'):not(:has(*:has(button:has-text('Remove')):has-text('{{item}}'))) >> button:has-text('Remove')", "timeout": 2000}
      ],
      "stays_on_screen": true
    },
    "search_products": {
      "description": "Open the accessories catalog, the only place the site lists products. The query does not filter anything; read the product names from page_info.",
      "params": {
        "query": {"type": "string", "required": true, "description": "What you are looking for (not used to filter)"}
      },
      "steps": [
        {"action": "navigate", "url": "https://www.prose.com/products/accessories"},
        {"action": "wait", "strategy": "selector_visible", "selector": "a[href*='/products/'] h2", "timeout": 8000}
      ],
      "target_screen": "accessories"
    }
  },
  "context_extractors": {
    "cart": {
      "steps": [
        {"action": "extract", "selector": "a[href*='/checkout/accessories']", "field": "summary"}
      ]
    }
  }
}
