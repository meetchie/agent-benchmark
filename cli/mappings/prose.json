{
  "site_id": "prose",
  "domain": "www.prose.com",
  "screens": {
    "homepage": {
      "url_pattern": "prose\\.com/?$",
      "available_actions": [
        "view_accessories",
        "view_product",
        "view_gift_cards",
        "view_cart",
        "search_products"
      ]
    },
    "accessories": {
      "url_pattern": "prose\\.com/products/accessories",
      "extraction": {
        "container": "main",
        "item": "a[href*='/products/']",
        "fields": {
          "name": "h3, h2, span",
          "price": "span:has-text('$')"
        }
      },
      "available_actions": [
        "view_product",
        "view_gift_cards",
        "view_cart"
      ]
    },
    "product_detail": {
      "url_pattern": "prose\\.com/products/prose-",
      "extraction": {
        "fields": {
          "name": "h1",
          "price": {"selector": "span:has-text('$')"},
          "description": "p"
        }
      },
      "available_actions": [
        "add_to_cart",
        "view_accessories",
        "view_cart",
        "go_back"
      ]
    },
    "brushes": {
      "url_pattern": "prose\\.com/products/brushes",
      "extraction": {
        "fields": {
          "name": "h1",
          "price": {"selector": "span:has-text('$')"},
          "material": "p:has-text('Material')",
          "variant_selector": "img[cursor='pointer']"
        }
      },
      "available_actions": [
        "add_to_cart",
        "view_product",
        "view_accessories",
        "view_cart",
        "go_back"
      ]
    },
    "cart": {
      "url_pattern": "prose\\.com/checkout/accessories",
      "extraction": {
        "fields": {
          "items": "li, tr, div:has-text('$')"
        }
      },
      "available_actions": [
        "remove_from_cart",
        "view_accessories",
        "go_back"
      ]
    },
    "gift": {
      "url_pattern": "prose\\.com/gift",
      "extraction": {
        "fields": {
          "amount": "span:has-text('$')",
          "recipient_field": "input[placeholder*='Who']"
        }
      },
      "available_actions": [
        "view_accessories",
        "go_back"
      ]
    }
  },
  "actions": {
    "view_accessories": {
      "steps": [
        {
          "action": "navigate",
          "url": "https://www.prose.com/products/accessories"
        },
        {
          "action": "wait",
          "strategy": "delay",
          "timeout": 2000
        }
      ],
      "target_screen": "accessories"
    },
    "view_product": {
      "params": {
        "item": {"type": "string", "required": true}
      },
      "steps": [
        {
          "action": "navigate",
          "url": "https://www.prose.com/products/accessories"
        },
        {
          "action": "wait",
          "strategy": "delay",
          "timeout": 2000
        },
        {
          "action": "click",
          "selector": "#bottom-modal-close-b",
          "optional": true,
          "timeout": 2000,
          "fallbacks": [
            {"type": "css", "selector": "button[id*='modal-close']"},
            {"type": "css", "selector": "[role='dialog'] button[aria-label*='close']"}
          ]
        },
        {
          "action": "click",
          "selector": "a:has-text('{{item}}')",
          "fallbacks": [
            {"type": "text", "selector": "{{item}}"},
            {"type": "css", "selector": "[href*='{{item}}']"}
          ]
        },
        {
          "action": "wait",
          "strategy": "delay",
          "timeout": 2000
        }
      ],
      "target_screen": "product_detail"
    },
    "add_to_cart": {
      "params": {
        "item": {"type": "string", "required": true}
      },
      "steps": [
        {
          "action": "click",
          "selector": "#bottom-modal-close-b",
          "optional": true,
          "timeout": 2000,
          "fallbacks": [
            {"type": "css", "selector": "button[id*='modal-close']"},
            {"type": "css", "selector": "[role='dialog'] button[aria-label*='close']"},
            {"type": "css", "selector": "[role='dialog'] button[aria-label*='Close']"}
          ]
        },
        {
          "action": "wait",
          "strategy": "selector_visible",
          "selector": "button:has-text('Add to cart')",
          "timeout": 10000
        },
        {
          "action": "click",
          "selector": "button:has-text('Add to cart')",
          "timeout": 10000,
          "fallbacks": [
            {"type": "text", "selector": "Add to cart"},
            {"type": "css", "selector": "button:text-is('Add to cart')"}
          ]
        },
        {
          "action": "wait",
          "strategy": "delay",
          "timeout": 2000
        }
      ],
      "stays_on_screen": true
    },
    "view_cart": {
      "steps": [
        {
          "action": "navigate",
          "url": "https://www.prose.com/checkout/accessories"
        },
        {
          "action": "wait",
          "strategy": "delay",
          "timeout": 2000
        }
      ],
      "target_screen": "cart"
    },
    "view_gift_cards": {
      "steps": [
        {
          "action": "navigate",
          "url": "https://www.prose.com/gift"
        },
        {
          "action": "wait",
          "strategy": "delay",
          "timeout": 2000
        }
      ],
      "target_screen": "gift"
    },
    "go_back": {
      "steps": [
        {
          "action": "navigate",
          "url": "https://www.prose.com/products/accessories"
        }
      ],
      "target_screen": "accessories"
    },
    "remove_from_cart": {
      "params": {
        "item": {"type": "string", "required": true}
      },
      "steps": [
        {
          "action": "click",
          "selector": "button:has-text('Remove')",
          "fallbacks": [
            {"type": "text", "selector": "Remove"},
            {"type": "css", "selector": "button[aria-label*='Remove']"}
          ]
        },
        {
          "action": "wait",
          "strategy": "delay",
          "timeout": 1000
        }
      ],
      "stays_on_screen": true
    },
    "search_products": {
      "params": {
        "query": {"type": "string", "required": true}
      },
      "steps": [
        {
          "action": "navigate",
          "url": "https://www.prose.com/products/accessories"
        },
        {
          "action": "wait",
          "strategy": "delay",
          "timeout": 2000
        }
      ],
      "target_screen": "accessories"
    }
  },
  "context_extractors": {
    "cart": {
      "steps": [
        {
          "action": "extract",
          "selector": "a[href*='/checkout/accessories']",
          "field": "summary"
        }
      ]
    }
  }
}
