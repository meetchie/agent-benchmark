{
  "site_id": "prose",
  "domain": "www.prose.com",
  "screens": {
    "homepage": {
      "url_pattern": "prose\\.com/?$",
      "available_actions": [
        "view_accessories",
        "view_product",
        "view_gift_cards",
        "view_cart",
        "search_products"
      ]
    },
    "accessories": {
      "url_pattern": "prose\\.com/products/accessories",
      "available_actions": [
        "view_product",
        "view_gift_cards",
        "view_cart"
      ]
    },
    "product_detail": {
      "url_pattern": "prose\\.com/products/prose-",
      "available_actions": [
        "add_to_cart",
        "view_accessories",
        "view_cart",
        "go_back"
      ]
    },
    "brushes": {
      "url_pattern": "prose\\.com/products/brushes",
      "available_actions": [
        "add_to_cart",
        "view_product",
        "view_accessories",
        "view_cart",
        "go_back"
      ]
    },
    "cart": {
      "url_pattern": "prose\\.com/checkout/accessories",
      "available_actions": [
        "remove_from_cart",
        "view_accessories",
        "go_back"
      ]
    },
    "gift": {
      "url_pattern": "prose\\.com/gift",
      "available_actions": [
        "view_accessories",
        "go_back"
      ]
    }
  },
  "actions": {
    "view_accessories": {
      "steps": [
        {
          "action": "navigate",
          "url": "https://www.prose.com/products/accessories"
        },
        {
          "action": "wait",
          "strategy": "selector_visible",
          "selector": "h2",
          "timeout": 10000
        }
      ],
      "target_screen": "accessories"
    },
    "view_product": {
      "params": {
        "item": {"type": "string", "required": true}
      },
      "steps": [
        {
          "action": "navigate",
          "url": "https://www.prose.com/products/accessories"
        },
        {
          "action": "wait",
          "strategy": "selector_visible",
          "selector": "h2",
          "timeout": 10000
        },
        {
          "action": "click",
          "selector": "#bottom-modal-close-b",
          "optional": true,
          "timeout": 1000,
          "fallbacks": [
            {"type": "css", "selector": "button[id*='modal-close']"}
          ]
        },
        {
          "action": "click",
          "selector": "a:has-text('{{item}}')",
          "fallbacks": [
            {"type": "text", "selector": "{{item}}"},
            {"type": "css", "selector": "[href*='{{item}}']"}
          ]
        },
        {
          "action": "wait",
          "strategy": "selector_visible",
          "selector": "h1",
          "timeout": 10000
        }
      ],
      "target_screen": "product_detail"
    },
    "add_to_cart": {
      "params": {
        "item": {"type": "string", "required": true}
      },
      "steps": [
        {
          "action": "click",
          "selector": "#bottom-modal-close-b",
          "optional": true,
          "timeout": 1000,
          "fallbacks": [
            {"type": "css", "selector": "button[id*='modal-close']"}
          ]
        },
        {
          "action": "wait",
          "strategy": "selector_visible",
          "selector": "button:has-text('Add to cart')",
          "timeout": 5000
        },
        {
          "action": "click",
          "selector": "button:has-text('Add to cart')",
          "fallbacks": [
            {"type": "text", "selector": "Add to cart"}
          ]
        }
      ],
      "stays_on_screen": true
    },
    "view_cart": {
      "steps": [
        {
          "action": "navigate",
          "url": "https://www.prose.com/checkout/accessories"
        },
        {
          "action": "wait",
          "strategy": "selector_visible",
          "selector": "main",
          "timeout": 10000
        }
      ],
      "target_screen": "cart"
    },
    "view_gift_cards": {
      "steps": [
        {
          "action": "navigate",
          "url": "https://www.prose.com/gift"
        },
        {
          "action": "wait",
          "strategy": "selector_visible",
          "selector": "main",
          "timeout": 10000
        }
      ],
      "target_screen": "gift"
    },
    "go_back": {
      "steps": [
        {
          "action": "navigate",
          "url": "https://www.prose.com/products/accessories"
        },
        {
          "action": "wait",
          "strategy": "selector_visible",
          "selector": "h2",
          "timeout": 10000
        }
      ],
      "target_screen": "accessories"
    },
    "remove_from_cart": {
      "params": {
        "item": {"type": "string", "required": true}
      },
      "steps": [
        {
          "action": "click",
          "selector": "button:has-text('Remove')",
          "fallbacks": [
            {"type": "text", "selector": "Remove"},
            {"type": "css", "selector": "button[aria-label*='Remove']"}
          ]
        }
      ],
      "stays_on_screen": true
    },
    "search_products": {
      "params": {
        "query": {"type": "string", "required": true}
      },
      "steps": [
        {
          "action": "navigate",
          "url": "https://www.prose.com/products/accessories"
        },
        {
          "action": "wait",
          "strategy": "selector_visible",
          "selector": "h2",
          "timeout": 10000
        }
      ],
      "target_screen": "accessories"
    }
  },
  "context_extractors": {
    "cart": {
      "steps": [
        {
          "action": "extract",
          "selector": "a[href*='/checkout/accessories']",
          "field": "summary"
        }
      ]
    }
  }
}
