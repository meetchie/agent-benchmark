# =============================================================================
# .env.example  ->  copy to .env in the repository root and fill in
# =============================================================================
#   cp .env.example .env
#
# The only value you need is ANTHROPIC_API_KEY. Every other line is optional: it
# is commented out and shows the default, so uncomment a line only to change it.
# (`make demo` needs no key at all.)
#
# Where .env is read:
#   - The Python code (live-benchmark server, arena, comparison CLI) loads
#     server/.env first and then this file, through server/runtime_env.py.
#     A variable already set in your shell beats both files, and server/.env
#     beats this file, so keep one .env and put it here.
#   - The web dev server (Vite) reads this same file. Only VITE_* values ever
#     reach browser code.
#   - .env and .env.* are gitignored; only this example is committed.

# =============================================================================
# Model provider (required)
# =============================================================================
# Claude API key. Used for the benchmark agent, the judge, the task generator and
# the arena and CLI arms. Leave the value empty here and fill it in your own .env.
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=            # accepted in place of the API key

# "anthropic" (default) or "openai". openai runs the original gpt-4o setup; it needs
# `cd server && uv sync --extra openai` and OPENAI_API_KEY (below).
# LLM_PROVIDER=anthropic
# OPENAI_API_KEY=                  # only with LLM_PROVIDER=openai

# One model per role. Defaults: claude-sonnet-5-5 (anthropic), gpt-4o (openai).
# BENCHMARK_AGENT_MODEL=claude-sonnet-5-5
# BENCHMARK_JUDGE_MODEL=claude-sonnet-5-5
# BENCHMARK_TASKGEN_MODEL=claude-sonnet-5-5

# Effort per role: low, medium, high, xhigh, max, or "default" (send none).
# Defaults: medium for the agent on current Claude models, the model's own default
# for the judge and the task generator.
# BENCHMARK_AGENT_EFFORT=medium
# BENCHMARK_JUDGE_EFFORT=
# BENCHMARK_TASKGEN_EFFORT=

# "off" turns off the server-side refusal fallback that is sent on the models that
# support it (claude-sonnet-5-5, the Opus models). Default: on.
# LLM_FALLBACKS=default

# =============================================================================
# Live-benchmark server (server/server.py)
# =============================================================================
# Canned runs and tasks: the whole UI works with no key and no browser.
# DEMO_MODE=false

# Hard limit for one agent run, in seconds. Over it the run is reported as too_slow.
# BENCHMARK_TIMEOUT_S=180

# Who may use the server: "none" (one local user, no sign-in) or "clerk" (see the
# Clerk section below).
# AUTH_MODE=none

# Runs per user per rolling 24 hours; 0 = unlimited. Default: 0 with AUTH_MODE=none,
# 3 with AUTH_MODE=clerk.
# DAILY_RUN_QUOTA=
# Runs one user may have going at once; 0 = unlimited.
# MAX_CONCURRENT_RUNS=2

# Where finished runs are saved, one JSON file each. Default: server/runs/ (a relative
# value is resolved against server/). The run counter file lives in here too.
# RUNS_DIR=

# CORS origins, comma separated. The web UI reaches the server through the Vite
# proxy, so the default (the Vite dev servers on localhost) is normally right.
# ALLOWED_ORIGINS=http://localhost:5180,http://localhost:5173,http://127.0.0.1:5180,http://127.0.0.1:5173

# If set, requests must send it in the X-Internal-Key header. Not needed locally.
# INTERNAL_API_KEY=

# =============================================================================
# Browser (live benchmark, arena, comparison CLI)
# =============================================================================
# Chromium runs headless by default; set to false to watch it. Every launch carries
# --use-mock-keychain --password-store=basic, so macOS never asks about the keychain.
# BENCHMARK_HEADLESS=true

# Use a Chromium-based browser other than the one `playwright install chromium`
# put in place.
# BENCHMARK_CHROMIUM_PATH=

# Where Playwright keeps its browsers. Default: ~/Library/Caches/ms-playwright on
# macOS, ~/.cache/ms-playwright on Linux.
# PLAYWRIGHT_BROWSERS_PATH=

# "local" (default, Chromium on this machine) or "browserbase" (a cloud browser; needs
# the two Browserbase values below and a Browserbase account). Live benchmark only.
# BENCHMARK_BROWSER_PROVIDER=local
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=

# browser-use's anonymous telemetry, cloud sync and its pypi.org version check are
# switched off by server/runtime_env.py. Export one as "true" to turn it back on.
# ANONYMIZED_TELEMETRY=false
# BROWSER_USE_CLOUD_SYNC=false
# BROWSER_USE_VERSION_CHECK=false

# =============================================================================
# Web UI (web/)
# =============================================================================
# Backend that the Vite dev and preview servers proxy /api/benchmark/* to. `make dev`
# starts the backend on the port in this URL.
# BENCHMARK_API_URL=http://127.0.0.1:8000
# Port of the Vite dev and preview servers.
# BENCHMARK_WEB_PORT=5180

# =============================================================================
# Clerk sign-in (optional; the default needs no account)
# =============================================================================
# Set all of these only to run the hosted-style setup with real sign-in:
# AUTH_MODE=clerk on the server, plus either CLERK_ISSUER_URL or CLERK_PUBLISHABLE_KEY
# for it to verify tokens with, and VITE_CLERK_PUBLISHABLE_KEY (the same publishable
# key) so the web UI shows the Clerk sign-in. See "Optional: Clerk sign-in" in README.md.
# CLERK_PUBLISHABLE_KEY=
# CLERK_ISSUER_URL=                # takes priority over the key above
# CLERK_JWKS_URL=                  # default: <issuer>/.well-known/jwks.json
# VITE_CLERK_PUBLISHABLE_KEY=
